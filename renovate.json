{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "security:minimumReleaseAgeNpm"],
  "minimumReleaseAgePackageManagerSync": true,
  "timezone": "Europe/Paris",
  "labels": ["dependencies"],
  "enabledManagers": ["npm", "nvm", "github-actions"],
  "automerge": false,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "description": "Security fixes are opened immediately, at the lowest fixing version, and routed by renovate-triage.yml (CVSS) between automerge and manual review.",
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"],
    "prCreation": "immediate",
    "rangeStrategy": "bump",
    "vulnerabilityFixStrategy": "lowest",
    "minimumReleaseAge": null,
    "automerge": false
  },
  "lockFileMaintenance": {
    "description": "A weekly re-lock of package-lock.json keeps transitive dependencies fresh.",
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Batch routine updates once a week.",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "schedule": ["before 6am on monday"]
    },
    {
      "matchUpdateTypes": ["major"],
      "schedule": ["before 6am on monday"]
    },
    {
      "description": "algoan/renovate-security-actions runs the Renovate triage and automerge: its updates come in their own PR, for a human review.",
      "matchPackageNames": ["algoan/renovate-security-actions"],
      "groupName": "algoan renovate-security-actions",
      "groupSlug": "algoan-renovate-security-actions"
    }
  ]
}
